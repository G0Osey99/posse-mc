{
  "name": "posse-mc",
  "version": "0.6.1",
  "description": "A fleet-optimized Minecraft bot client (1.8.9 to latest) with a mineflayer-compatible API: digging, building, crafting, trading, pathfinding and first-person screenshots",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./view": {
      "types": "./dist/view/index.d.ts",
      "import": "./dist/view/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test bench",
    "format": "prettier --write src test bench",
    "test": "vitest run",
    "verify": "tsx bench/verify.ts --client posse",
    "bench": "tsx bench/bench.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "minecraft",
    "bot",
    "mineflayer",
    "minecraft-protocol",
    "fleet",
    "screenshot",
    "pathfinder",
    "pathfinding",
    "crafting",
    "digging"
  ],
  "author": "G0Osey99",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/G0Osey99/posse-mc.git"
  },
  "homepage": "https://github.com/G0Osey99/posse-mc#readme",
  "bugs": {
    "url": "https://github.com/G0Osey99/posse-mc/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "minecraft-data": "^3.117.0",
    "minecraft-protocol": "^1.68.0",
    "prismarine-block": "^1.22.0",
    "prismarine-chat": "^1.12.0",
    "prismarine-chunk": "^1.41.0",
    "prismarine-entity": "^2.5.0",
    "prismarine-item": "^1.17.0",
    "prismarine-nbt": "^2.8.0",
    "prismarine-physics": "^1.11.1",
    "prismarine-registry": "^1.11.0",
    "prismarine-windows": "^2.9.0",
    "vec3": "^0.1.8"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "mineflayer": "^4.39.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
